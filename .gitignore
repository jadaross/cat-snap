# macOS
.DS_Store

# Xcode — user-specific state
xcuserdata/
*.xcuserstate
*.mode1v3
*.mode2v3
*.perspectivev3

# Xcode — build artifacts
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager — local resolution
.swiftpm/
Packages/
Package.pins
Package.resolved

# CocoaPods (in case it ever comes back)
Pods/

# fastlane (in case it ever comes back)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Local config — secrets stay out of git, examples are committed
*.xcconfig
!*.example.xcconfig

# Claude Code agent session state
.agents/*
skills-lock.json
