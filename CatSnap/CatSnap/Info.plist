<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>CatSnap uses the camera so you can photograph cats you spot.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CatSnap tags each sighting with the spot you saw the cat, so others can find them too.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CatSnap reads photos from your library when you pick one to log a sighting.</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>UIAppFonts</key>
	<array>
		<string>PlusJakartaSans-Bold.ttf</string>
		<string>Fraunces72pt-BlackItalic.ttf</string>
		<string>PlusJakartaSans-Medium.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>PlusJakartaSans-Regular.ttf</string>
		<string>PlusJakartaSans-SemiBold.ttf</string>
	</array>
</dict>
</plist>
